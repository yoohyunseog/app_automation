eft\"}},\"sellerNo\":null,\"isAiWriter\":false}}},\"editorFontOptions\":{\"loading\":false,\"loaded\":false,\"data\":{\"defaultEditorVersion\":4,\"writeFontOptions\":{\"fontType\":1,\"fontSize\":15,\"fontColor\":\"#000000\",\"lineSpace\":180,\"textAlign\":0}}},\"blogInfo\":{\"loading\":false,\"loaded\":true,\"data\":{\"blogId\":\"dbghwns2\",\"blogNo\":630114,\"nickName\":\"7과 1LV 왕호떡\",\"blogName\":\"참소식 블로그\",\"introduce\":\"유현석 관기자는 ‘비어도 지배자’ 소속 경매장 활동가로, 레벨 9~10이며 8비트 트레이드를 통해 경험치를 얻고 있다. 수익은 없으며, 꽃 반지, 비행접시, 포스 등은 모두 경험치(Exp)로 축적된다. 1996년, 월드컵 열기에 이끌려 한국 중등부 축구부에 가입해 ‘애매한 꼬봉’으로 활동한 이력이 있으며, 최근 1달란트로 한글 도메인 서류를 구매했고, 50원으로 소소한 교환 거래를 진행했다.\",\"profileUrl\":\"\\u002FMjAyMzA1MTJfMTMw\\u002FMDAxNjgzODIyNTcyMjI4._pcqWDfSiF2N5papHCQbxLdvkGBgxt1CRat6dCVYg-wg.zXLuK1gacUSdoolqSp9nA9GXvpQ7SWpAUam2bCXCdl8g.JPEG.dbghwns2\\u002F5f16ba1f-ba15-4dee-a1f7-383fb1c16eae.jpg\\u002F5f16ba1f-ba15-4dee-a1f7-383fb1c16eae.jpg\",\"blogRelationType\":\"BLOG_OWNER\",\"defaultEditorVersion\":4}},\"productSaleDuration\":{\"loading\":false,\"loaded\":false,\"data\":{\"permanentSaleYn\":true}},\"products\":{},\"sellerCandidate\":{},\"postListCount\":{},\"notSponsoredAgreement\":{}},\"cart\":{\"cartList\":{\"loading\":false,\"loaded\":false}},\"blogHome\":{\"blogHomeInfo\":{},\"blockLayoutList\":{},\"blogUserInfo\":{},\"externalChannelList\":{},\"noticeList\":{},\"talkTalk\":{},\"blogIntroduce\":{},\"blogReputation\":{},\"blogHomePostList\":{},\"blogHomePopularList\":{},\"popularPostBlock\":{},\"blogBusinessInfo\":{},\"blogCategoryList\":{},\"blogHomeError\":{},\"blogMarketProduct\":{},\"blogClipList\":{},\"blogBlockInfo\":{},\"blogContentsCount\":{},\"blogMyMaterial\":{}},\"seller\":{\"sellerStatusInfo\":{},\"marketAuthFile\":{}},\"postReaction\":{\"postReactionUserList\":{}},\"commentList\":{\"cboxPostInfo\":{},\"cboxPostMention\":{},\"cboxPostCommentsInfo\":{}},\"news\":{\"notifyList\":{},\"activityList\":{},\"mrBlogQuestion\":{}},\"ros\":{\"status\":{\"loading\":false,\"loaded\":false}},\"s