매한 꼬봉’으로 활동한 이력이 있으며, 최근 1달란트로 한글 도메인 서류를 구매했고, 50원으로 소소한 교환 거래를 진행했다.\",\"profileUrl\":\"\\u002FMjAyMzA1MTJfMTMw\\u002FMDAxNjgzODIyNTcyMjI4._pcqWDfSiF2N5papHCQbxLdvkGBgxt1CRat6dCVYg-wg.zXLuK1gacUSdoolqSp9nA9GXvpQ7SWpAUam2bCXCdl8g.JPEG.dbghwns2\\u002F5f16ba1f-ba15-4dee-a1f7-383fb1c16eae.jpg\\u002F5f16ba1f-ba15-4dee-a1f7-383fb1c16eae.jpg\",\"blogRelationType\":\"BLOG_OWNER\",\"defaultEditorVersion\":4}},\"productSaleDuration\":{\"loading\":false,\"loaded\":false,\"data\":{\"permanentSaleYn\":true}},\"products\":{},\"sellerCandidate\":{},\"postListCount\":{},\"notSponsoredAgreement\":{}},\"cart\":{\"cartList\":{\"loading\":false,\"loaded\":false}},\"blogHome\":{\"blogHomeInfo\":{},\"blockLayoutList\":{},\"blogUserInfo\":{},\"externalChannelList\":{},\"noticeList\":{},\"talkTalk\":{},\"blogIntroduce\":{},\"blogReputation\":{},\"blogHomePostList\":{},\"blogHomePopularList\":{},\"popularPostBlock\":{},\"blogBusinessInfo\":{},\"blogCategoryList\":{},\"blogHomeError\":{},\"blogMarketProduct\":{},\"blogClipList\":{},\"blogBlockInfo\":{},\"blogContentsCount\":{},\"blogMyMaterial\":{}},\"seller\":{\"sellerStatusInfo\":{},\"marketAuthFile\":{}},\"postReaction\":{\"postReactionUserList\":{}},\"commentList\":{\"cboxPostInfo\":{},\"cboxPostMention\":{},\"cboxPostCommentsInfo\":{}},\"news\":{\"notifyList\":{},\"activityList\":{},\"mrBlogQuestion\":{}},\"ros\":{\"status\":{\"loading\":false,\"loaded\":false}},\"ssr\":{\"isSSR\":true},\"domain\":{\"domainProfilePreset\":{},\"redirectInfo\":{}},\"buddyList\":{\"buddyList\":{}},\"naverPost\":{\"naverPostToast\":{\"loading\":false,\"loaded\":false}},\"challengeInfo\":{\"challengeOwnerInfo\":{\"loading\":false,\"loaded\":false},\"challengeCategory\":{\"loading\":false,\"loaded\":false}},\"checkIn\":{\"otherCheckInList\":{},\"checkInDateList\":{},\"placeCountDate\":{\"loading\":false,\"loaded\":false},\"regionCheckInListAll\":{\"loading\":false,\"loaded\":false,\"data\":{\"items\":[],\"meta\":{\"currentCursor\":1,\"nextCursor\":null}}},\