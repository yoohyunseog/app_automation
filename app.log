oating-material-tooltip\" id=\"__se-f-m-tooltip-tooltip-news\" role=\"tooltip\" aria-hidden=\"true\">\u003Cspan class=\"se-floating-material-tooltip-title\">뉴스 글감\u003C/span>\u003C/div>\u003C/button>\u003C/div>\u003C/div>\u003Cdiv class=\"se-floating-material-menu-line\">\u003C/div>\u003Cdiv class=\"se-floating-material-menu-toggle-button-wrapper\">\u003Cbutton type=\"button\" data-log=\"matflt.fold\" class=\"se-floating-category-button-shrink\" aria-label=\"접기\" aria-describedby=\"tooltip-shrink\">\u003Cdiv class=\"se-floating-material-tooltip\" id=\"__se-f-m-tooltip-tooltip-shrink\" role=\"tooltip\" aria-hidden=\"true\">\u003Cspan class=\"se-floating-material-tooltip-title\">접기\u003C/span>\u003C/div>\u003C/button>\u003C/div>\u003C/div>\u003Cdiv class=\"se-floating-search-area se-is-collapsed\" style=\"--expand-width: 478px;\">\u003Cform class=\"se-floating-search-wrapper\" role=\"search\">\u003Cbutton type=\"button\" data-log=\"matflt.search\" class=\"se-floating-search-button\" aria-label=\"검색\" aria-describedby=\"tooltip-search\">\u003Cdiv class=\"se-floating-material-tooltip\" id=\"__se-f-m-tooltip-tooltip-search\" role=\"tooltip\" aria-hidden=\"true\">\u003Cspan class=\"se-floating-material-tooltip-title\">검색\u003C/span>\u003C/div>\u003C/button>\u003Cinput type=\"text\" name=\"material-search\" class=\"se-floating-search-input-search\" placeholder=\"글감을 검색해 보세요.\" aria-label=\"글감을 검색해 보세요.\" autocomplete=\"off\" value=\"\">\u003C/form>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cdiv aria-live=\"assertive\" tabindex=\"-1\" style=\"position: absolute; left: -10000px; top: -1px; z-index: -2; opacity: 0; transform: rotateX(90deg);\">더 많은 소식이 궁금하다면 참소식 포켓 뉴스에서 확인해보시겠어요?\u2726한국 경제 회복, 그림자는 어디인가요?최근 한국 경제가 회복세를 보이고 있습니다. 하지만 여전히 그림자는 어디에 있나요? 라는 물음이 남아 있죠.\u2727핵심 메시지경제는 성장하고 있지만, 중소·지방·청년 등 취약 계층에게는 여전히 불균형이 심합니다. 이는 우리 사회의 그림자라 부를 수 있겠네요.\u272a구조를 한눈에다이어그램을 보면 회복↗\ufe0e 취약계층↘\ufe0e 대기업\u2011중소 협력이 핵심이라는 흐름이 드러납니다. 구조 다이어그램은 어떻게 해석하나요? 라는 질문이 자연스럽게 떠오릅니다.\u2740트렌드와 인사이트- 회복·성장률은 2~3%지만, 중소기업 매출 성장률은 0.8%에 머물고 있습니다.- 대기업 퇴직연금·스타트업 투자 등 현재의 투자 전략이 활발합니다.- 지역·청년 파트너십이 새로운 성장 동력으로 떠오르고 있습니다.실천 로드맵1\ufe0f\u20e3 대기업은 중소기업 전용 전략 펀드와 공동 R&amp;D를 추진해야 합니다.2\ufe0f\u20e3 지방정부는 세제·인프라·청년 창업 지원을 확대하고, 금융기관은 지역·중소기업 채권을 활성화해야 합니다.3\ufe0f\u20e3 우리 모두는 ‘로컬 소비’와 기업\u2011투자 파트너십에 참여해 보세요.\u273f결론회복만으로는 충분하지 않습니다. 온전한 회복을 위한 길은 공유된 성장이며, 모두가 함께 만들어가야 할 과제입니다.한국경제 회복 불균형 투자 상생\U0001f4ac K-POP / K-드라마 / 게임 트렌드 + 네이버 실시간 키워드 분석 + 자동화 커뮤니티\U0001f310 디스코드 채널 바로가기  선택됨 \u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003C/div>\u003Cscript async=\"\" src=\"https://ntm.pstatic.net/ex/nlog.js\">\u003C/script>\u003Cscript async=\"\" src=\"https://ntm.pstatic.net/scripts/ntm_d26044233161.js\">\u003C/script>\u003Cscript id=\"initialState\">window.__PRODUCTION_ENV__ = \"real\";\n    window.__INITIAL_STATE__ = {\"abTest\":{},\"market\":{\"product\":{},\"blogProduct\":{},\"categories\":{\"loading\":false,\"loaded\":false},\"detailCategories\":{\"loading\":false,\"loaded\":false},\"categoryNotice\":{},\"userCategoryNotice\":{},\"productForm\":{},\"marketProductList\":{\"loading\":false,\"loaded\":false,\"data\":{\"items\":[],\"meta\":{\"currentCursor\":1,\"nextCursor\":null}}},\"serviceProducts\":{},\"myProducts\":{\"PENDING\":{\"data\":{\"meta\":{\"currentCursor\":1},\"items\":[]}}},\"myProductCount\":{\"loading\":false,\"loaded\":false},\"noticeCondition\":{\"loading\":false,\"loaded\":false},\"marketNowStatus\":{\"claim\":{\"loading\":false,\"loaded\":false},\"delay\":{\"loading\":false,\"loaded\":false},\"inquiry\":{\"loading\":false,\"loaded\":false},\"sale\":{\"loading\":false,\"loaded\":false},\"settle\":{\"loading\":false,\"loaded\":false},\"notice\":{\"loading\":false,\"loaded\":false}},\"seller\":{\"dbghwns2\":{\"loading\":false,\"loaded\":true,\"dataKey\":\"dbghwns2\",\"data\":{\"sellerNo\":58406,\"sellerId\":\"dbghwns2\",\"status\":\"NO_SIGN_UP\",\"serviceType\":null,\"selfAuthYn\":true,\"agreeYn\":true,\"feePrice\":null,\"conditionalF